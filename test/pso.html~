<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PSO-1 Scope Simulator</title>
    <style>
        body {
            background-color: #2c3e50;
            color: white;
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        /* Scope Viewport Styling */
        #scope-lens {
            width: 600px;
            height: 600px;
            background-color: #8da496; /* Daylight optical glass color */
            border: 20px solid #111;
            border-radius: 50%;
            box-shadow: inset 0 0 50px rgba(0,0,0,0.8), 0 10px 30px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
            transition: background-color 0.3s;
        }

        /* Standard Daylight Reticle */
        .reticle-container {
            width: 100%;
            height: 100%;
            color: #1a1a1a; /* Black etched glass */
            transition: all 0.3s;
        }

        /* Illuminated Night Vision Mode */
        .illuminated .reticle-container {
            color: #ff2a2a; /* Bright red */
            filter: drop-shadow(0 0 3px rgba(255, 0, 0, 0.8));
        }
        
        .illuminated#scope-lens {
            background-color: #1a251d; /* Darkened glass for night use */
        }

        .controls {
            margin-top: 20px;
            background: rgba(0,0,0,0.5);
            padding: 15px;
            border-radius: 8px;
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 4px;
        }
        
        button:hover {
            background-color: #2980b9;
        }
    </style>
</head>
<body>

    <h1>PSO-1 Telemetric Simulation</h1>
    
    <!-- The Scope Viewport -->
    <div id="scope-lens">
        <div id="reticle-mount" class="reticle-container">
            <!-- SVG will be injected here -->
        </div>
    </div>

    <!-- UI Controls -->
    <div class="controls">
        <button id="toggle-illumination">Toggle Illumination</button>
    </div>

    <!-- Include your generator logic -->
    <script src="pso1.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 1. Instantiate the generator
            // Uses the default 1.7m calibration as per Soviet doctrine
            const pso1 = new PSO1ReticleGenerator();

            // 2. Render and inject the SVG into the DOM
            const mount = document.getElementById('reticle-mount');
            mount.innerHTML = pso1.render();

            // 3. Setup Illumination Toggle
            const scopeLens = document.getElementById('scope-lens');
            const toggleBtn = document.getElementById('toggle-illumination');

            toggleBtn.addEventListener('click', () => {
                scopeLens.classList.toggle('illuminated');
            });
        });
    </script>
</body>
</html>